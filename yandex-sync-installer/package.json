{
  "name": "yandex-sync-installer",
  "version": "1.3.1",
  "description": "Installer and patcher for BetterYandexMusic sync",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 >NUL & electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:deb": "electron-builder --linux deb",
    "dist:appimage": "electron-builder --linux AppImage"
  },
  "author": "IvanForze <ivanforze@users.noreply.github.com>",
  "homepage": "https://github.com/IvanForze/BetterYandexMusic",
  "license": "ISC",
  "dependencies": {
    "@electron/asar": "^3.2.14",
    "@electron/fuses": "^1.8.0"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.better.yandexmusic.installer",
    "productName": "BetterYandexMusic Installer",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "socket.io.js",
          "desktop-sync.js",
          "sync-server.bundle.js"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/Icon-iOS-Default-1024x1024@1x.png"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/Icon.png"
    },
    "linux": {
      "maintainer": "IvanForze <ivanforze@users.noreply.github.com>",
      "category": "Audio",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/Icon.png"
    },
    "deb": {
      "packageCategory": "sound",
      "priority": "optional"
    }
  }
}
